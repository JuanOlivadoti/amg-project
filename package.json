{
  "name": "amg-os",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AMG OS — plataforma multi-tenant para la agencia de marketing gastronómico.",
  "workspaces": [
    "contrato",
    "db",
    "kr-service",
    "web-builder",
    "orchestrator",
    "api",
    "renderer"
  ],
  "scripts": {
    "verificar": "./scripts/verificar.sh",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "test": "npm run test --workspaces --if-present && node --import tsx --test \"scripts/*.test.mts\"",
    "credencial": "tsx scripts/credencial.mts",
    "probar-dsn": "tsx scripts/probar-dsn.mts",
    "auditar:railway": "tsx scripts/auditar-railway.mts",
    "env:sync": "tsx scripts/env-sync.mts",
    "reseed:demo": "tsx scripts/reseed-demo.mts",
    "build:portal": "npm --prefix portal ci && npm --prefix portal run build"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
