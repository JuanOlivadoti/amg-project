# db/.env — plantilla para los CLI de DESPLIEGUE de la base (una sola vez, al desplegar).
#
# Estas variables NO las usa ningún proceso en runtime: solo los dos comandos de deploy, corridos a
# mano contra Supabase. Van con conexión de ADMIN (superusuario del proyecto), no con `amg_api`.
#
#   DATABASE_URL_ADMIN=... npm run migrate:deploy -w db
#   DATABASE_URL_ADMIN=... SEED_FRANK_USER_ID=... SEED_JUAN_USER_ID=... npm run seed:demo -w db
#
# NO edites `db/.env` a mano: lo GENERA `npm run env:sync` desde docs/private/credenciales.env, y
# te lo va a sobrescribir. Poné los valores allá. Los dos scripts cargan `db/.env` solos
# (`tsx --env-file-if-exists=.env`), así que corrés `npm run migrate:deploy -w db` a secas.
#
# NO pases la variable en la línea de comandos: el comando queda guardado en el historial de la
# shell (en Windows, `ConsoleHost_history.txt` en texto plano), con la password de admin adentro.
#
# Este archivo es el CONTRATO del paquete: `scripts/env-sync.test.mts` verifica que la lista de
# claves de acá coincide exactamente con la del MAPA. Si agregás una clave acá, el test falla hasta
# que alguien decida en el MAPA si este paquete puede verla.

# Conexión de ADMIN de Supabase (rol `postgres`): crea roles y es dueña del esquema. Es la ÚNICA vez
# que se usa esta credencial; la API y el renderizador usan sus logins mínimos.
#
# Sale del botón verde "Connect" en la barra superior del proyecto → pestaña "Session pooler".
# (Ya NO está en Project Settings → Database: Supabase movió esa pantalla.)
# Ojo: con el pooler el usuario es `postgres.<project-ref>`, no `postgres` a secas. Si la password
# tiene `@ # / : ?`, percent-encodeala (`@` → `%40`) o el string se parsea mal.
DATABASE_URL_ADMIN=postgresql://postgres.PROJECT-REF:LA-PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Los `sub` (UUID) de los usuarios de Frank y Juan en Supabase Auth. Se crean ANTES del seed
# (Authentication → Users → Add user), y se copian sus IDs acá. Solo los usa `seed:demo`.
SEED_FRANK_USER_ID=
SEED_JUAN_USER_ID=
